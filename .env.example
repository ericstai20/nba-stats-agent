# Template for your settings. This file IS uploaded to GitHub, so it must only
# ever contain placeholders, never real keys.
#
# To use it: copy this file to a new file named .env and fill in your real values.
# Git ignores .env, so your real key stays on your computer.

# Your secret key from https://console.anthropic.com
ANTHROPIC_API_KEY=your-api-key-here

# Which Claude model the agent uses
ANTHROPIC_MODEL=claude-sonnet-5-5

# Where the Java app can find the Python stats-service
STATS_SERVICE_URL=http://localhost:8000
